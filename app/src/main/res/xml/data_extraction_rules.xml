<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the headset: the token's key lives in the Keystore and would not decrypt anywhere else anyway. -->
<data-extraction-rules>
  <cloud-backup>
    <exclude domain="root" />
    <exclude domain="sharedpref" />
    <exclude domain="database" />
    <exclude domain="file" />
  </cloud-backup>
  <device-transfer>
    <exclude domain="root" />
    <exclude domain="sharedpref" />
    <exclude domain="database" />
    <exclude domain="file" />
  </device-transfer>
</data-extraction-rules>
