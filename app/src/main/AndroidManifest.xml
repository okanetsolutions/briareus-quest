<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.RECORD_AUDIO" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
  <!-- The voice conversation runs the microphone and speaker as a call, for the echo canceller. -->
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

  <!-- A 2D panel app: no VR mode, no controllers or hand tracking required beyond the system pointer. -->
  <uses-feature android:name="android.hardware.microphone" android:required="false" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

  <application
    android:name=".BriareusApp"
    android:allowBackup="false"
    android:dataExtractionRules="@xml/data_extraction_rules"
    android:fullBackupContent="false"
    android:icon="@drawable/ic_launcher"
    android:label="@string/app_name"
    android:networkSecurityConfig="@xml/network_security_config"
    android:supportsRtl="true"
    android:theme="@style/Theme.Briareus">

    <meta-data android:name="com.oculus.supportedDevices" android:value="quest2|quest3|quest3s|questpro" />

    <!-- The main window: the projects and conversations beside the chosen conversation, wide like the dashboard. -->
    <activity
      android:name=".MainActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
      android:exported="true"
      android:launchMode="singleTask"
      android:resizeableActivity="true"
      android:windowSoftInputMode="adjustResize">
      <layout android:defaultWidth="1280dp" android:defaultHeight="800dp" android:minWidth="640dp" android:minHeight="480dp" />
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- One conversation in a window of its own, placed beside the others; one task per conversation. -->
    <activity
      android:name=".ConversationActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
      android:documentLaunchMode="intoExisting"
      android:exported="false"
      android:resizeableActivity="true"
      android:taskAffinity=""
      android:windowSoftInputMode="adjustResize">
      <layout android:defaultWidth="760dp" android:defaultHeight="900dp" android:minWidth="420dp" android:minHeight="480dp" />
    </activity>

    <!-- Native PR, diff and issue documents can sit beside the voice and conversation panels. -->
    <activity
      android:name=".PanelActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
      android:documentLaunchMode="intoExisting"
      android:exported="false"
      android:resizeableActivity="true"
      android:taskAffinity="">
      <layout android:defaultWidth="1000dp" android:defaultHeight="850dp" android:minWidth="420dp" android:minHeight="480dp" />
    </activity>

    <!-- The voice panel: talk to GPT-Realtime about your projects, and have the other windows follow. -->
    <activity
      android:name=".VoiceActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
      android:exported="false"
      android:launchMode="singleTask"
      android:resizeableActivity="true"
      android:taskAffinity="com.okanetsolutions.briareus.quest.voice">
      <layout android:defaultWidth="460dp" android:defaultHeight="720dp" android:minWidth="340dp" android:minHeight="420dp" />
    </activity>

    <!-- ▶ Run's preview: the served app in a browser of the app's own, which carries the preview service token. -->
    <activity
      android:name=".PreviewActivity"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
      android:exported="false"
      android:documentLaunchMode="intoExisting"
      android:resizeableActivity="true"
      android:taskAffinity=""
      android:windowSoftInputMode="adjustResize">
      <layout android:defaultWidth="1280dp" android:defaultHeight="800dp" android:minWidth="480dp" android:minHeight="400dp" />
    </activity>

    <!-- Keeps the microphone open while a voice conversation goes on and you look at another app. -->
    <service
      android:name=".VoiceService"
      android:exported="false"
      android:foregroundServiceType="microphone" />

  </application>
</manifest>
